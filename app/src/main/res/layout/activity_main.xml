<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_inicial"
            android:textColor="@color/neon_green"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardJogador1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/neon_green"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivUserJogador1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvLabelJogador1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/jogador1"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@id/ivUserJogador1"
                        app:layout_constraintStart_toEndOf="@id/ivUserJogador1"
                        app:layout_constraintTop_toTopOf="@id/ivUserJogador1" />

                    <TextView
                        android:id="@+id/tvVantagemJogador1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_vantagem"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="@string/vantagem"
                        android:textColor="@color/neon_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPontosJogador1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/placar_zerado"
                        android:textColor="@color/neon_green"
                        android:textSize="80sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelJogador1" />

                    <LinearLayout
                        android:id="@+id/llButtonsJogador1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/tvPontosJogador1">

                        <Button
                            android:id="@+id/btnJ1_1"
                            style="@style/ScoreButtonStyle"
                            android:text="@string/mais_1" />

                        <Button
                            android:id="@+id/btnJ1_3"
                            style="@style/ScoreButtonStyle"
                            android:text="@string/mais_3" />

                        <Button
                            android:id="@+id/btnJ1_6"
                            style="@style/ScoreButtonStyle"
                            android:text="@string/mais_6" />

                        <Button
                            android:id="@+id/btnJ1_9"
                            style="@style/ScoreButtonStyle"
                            android:text="@string/mais_9" />

                        <Button
                            android:id="@+id/btnJ1_12"
                            style="@style/ScoreButtonStyle"
                            android:text="@string/mais_12" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardJogador2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivUserJogador2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvLabelJogador2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/jogador2"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@id/ivUserJogador2"
                        app:layout_constraintStart_toEndOf="@id/ivUserJogador2"
                        app:layout_constraintTop_toTopOf="@id/ivUserJogador2" />

                    <TextView
                        android:id="@+id/tvVantagemJogador2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_vantagem"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="@string/vantagem"
                        android:textColor="@color/neon_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPontosJogador2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/placar_zerado"
                        android:textColor="@color/text_secondary"
                        android:textSize="80sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelJogador2" />

                    <LinearLayout
                        android:id="@+id/llButtonsJogador2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/tvPontosJogador2">

                        <Button
                            android:id="@+id/btnJ2_1"
                            style="@style/ScoreButtonStyleInactive"
                            android:text="@string/mais_1" />

                        <Button
                            android:id="@+id/btnJ2_3"
                            style="@style/ScoreButtonStyleInactive"
                            android:text="@string/mais_3" />

                        <Button
                            android:id="@+id/btnJ2_6"
                            style="@style/ScoreButtonStyleInactive"
                            android:text="@string/mais_6" />

                        <Button
                            android:id="@+id/btnJ2_9"
                            style="@style/ScoreButtonStyleInactive"
                            android:text="@string/mais_9" />

                        <Button
                            android:id="@+id/btnJ2_12"
                            style="@style/ScoreButtonStyleInactive"
                            android:text="@string/mais_12" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_dark"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimparTab"
            style="@style/NavButtonStyle"
            android:text="@string/limpar"
            app:icon="@android:drawable/ic_menu_rotate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNomesTab"
            style="@style/NavButtonStyle"
            android:text="@string/nomes"
            app:icon="@android:drawable/ic_menu_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistoricoTab"
            style="@style/NavButtonStyle"
            android:text="@string/historico_jogadas"
            app:icon="@android:drawable/ic_menu_recent_history" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>