<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F9FA"
    android:gravity="center_horizontal"
    tools:context=".HistoricoActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_historico"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#343A40"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <TextView
            android:id="@+id/tvHistoricoJ1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:text="@string/part_jogador1"
            android:textSize="18sp"
            android:textColor="#343A40"
            android:textStyle="bold"
            app:drawableStartCompat="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="16dp"
            app:drawableTint="#4CAF50" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <TextView
            android:id="@+id/tvHistoricoJ2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:text="@string/part_jogador2"
            android:textSize="18sp"
            android:textColor="#343A40"
            android:textStyle="bold"
            app:drawableStartCompat="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="16dp"
            app:drawableTint="#2196F3" />
    </androidx.cardview.widget.CardView>
</LinearLayout>